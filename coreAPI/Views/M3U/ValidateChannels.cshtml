@model coreAPI.Models.M3UValidationViewModel
@{
    ViewData["Title"] = "Validar Canales";
}

<h2>Validar Canales</h2>
<p>
    Se han comprobado @Model.Results.Count canales. Solo se sugieren para eliminar los que no responden o aparecen fuera de línea.
</p>

@if (Model.SuggestedCount > 0)
{
    <form asp-action="DeleteValidated" method="post" onsubmit="return confirm('¿Eliminar los canales seleccionados?');">
        @Html.AntiForgeryToken()
        <div class="table-responsive">
            <table class="table table-dark table-striped">
                <thead>
                    <tr>
                        <th>Eliminar</th>
                        <th>Estado</th>
                        <th>Canal</th>
                        <th>Información</th>
                        <th>URL</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model.Results)
                    {
                        <tr>
                            <td>
                                @if (result.SuggestDelete)
                                {
                                    <input type="checkbox" name="selectedIds" value="@result.Id" checked />
                                }
                            </td>
                            <td>@result.Status</td>
                            <td>@result.ChannelName</td>
                            <td>@result.Details</td>
                            <td>@result.StreamUrl</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button type="submit" class="btn btn-danger">Eliminar seleccionados</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
    </form>
}
else
{
    <div class="alert alert-success">No hay canales sugeridos para eliminar.</div>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Volver</a>
}
