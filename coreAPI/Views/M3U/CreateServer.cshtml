@model coreAPI.Models.ServerMapping
@{
    ViewData["Title"] = "Agregar servidor";
}

<h2>Agregar servidor</h2>

<form asp-action="CreateServer" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label" asp-for="Name"></label>
        <input class="form-control" asp-for="Name" placeholder="Ej.: home" />
        <div class="form-text">Es el valor que se utilizará en `/stream?id=...`.</div>
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="BaseUrl"></label>
        <input class="form-control" asp-for="BaseUrl" placeholder="https://servidor:444" />
        <span class="text-danger" asp-validation-for="BaseUrl"></span>
    </div>
    <button class="btn btn-success" type="submit">Guardar</button>
    <a class="btn btn-secondary" href="@Url.Action("Servers")">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
