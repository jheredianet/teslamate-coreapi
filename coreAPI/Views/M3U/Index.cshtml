@model List<coreAPI.Models.M3UEntry>
@{
    ViewData["Title"] = "Lista M3U";
    var groups = (IEnumerable<string>)ViewBag.Groups ?? Array.Empty<string>();
    string? selected = ViewBag.SelectedGroup as string;
    string? q = ViewBag.Query as string;
}

<h2>Lista M3U</h2>
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}


<form method="get" class="mb-3">
    <input type="text" name="q" value="@q" placeholder="Buscar por nombre o URL" />
    <select name="group">
        <option value="">Todos los grupos</option>
        @foreach (var g in groups)
        {
            <option value="@g" selected="@(g == selected ? "selected" : null)">@g</option>
        }
    </select>
    <button type="submit">Filtrar</button>
</form>

<div class="mb-3 d-flex align-items-center gap-2">
    <a class="btn btn-primary" href="@Url.Action("Create")">Agregar nuevo</a>
    <a class="btn btn-primary" href="@Url.Action("Download")">Exportar M3U</a>
    <a class="btn btn-primary" href="@Url.Action("Search")">Buscar</a>
    <form asp-action="Synchronize" method="post" class="d-inline-block m-0">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-success"
                onclick="return confirm('¿Sincronizar la lista con la fuente principal? Los canales remotos reemplazarán los datos de los canales con el mismo id AceStream.');">
            Sincronizar
        </button>
    </form>
</div>

<table id="m3u-list" class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Logo</th>
            <th>Canal</th>
            <th>Grupo</th>
            <th>Stream</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.TVGLogo))
                    {
                        <img src="@item.TVGLogo" style="height:30px" />
                    }
                </td>
                <td>@item.ChannelName</td>
                <td>@item.GroupTitle</td>
                <td>@item.StreamUrl</td>
                <td>
                    <div class="d-flex align-items-center gap-1">
                        <a class="btn btn-sm btn-warning" href="@Url.Action("Edit", new { id = item.Id })">Editar</a>
                        <form asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('¿Eliminar?');">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button class="btn btn-sm btn-danger" type="submit">Eliminar</button>
                            @Html.AntiForgeryToken()
                        </form>
                        <a class="btn btn-sm btn-primary" href="@Url.Action("Info", new { id = item.Id })">Info</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
